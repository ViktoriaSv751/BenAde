# --- Kötelező (Vercel → Settings → Environment Variables, Production + Preview) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_SITE_URL=https://benade.vercel.app
# Supabase → Project Settings → API → service_role (TITKOS, csak szerveroldalon)
SUPABASE_SERVICE_ROLE_KEY=
# A pg_cron által hívott értesítésküldő titka (ugyanaz, mint a setup_cron-ban megadott)
NOTIFY_SECRET=
# --- Push (web) – `npx web-push generate-vapid-keys` ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@benade.hu
# --- E-mail (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=BenAde <ertesites@benade.hu>
# --- Natív push (Android/iOS, Firebase Cloud Messaging, opcionális) ---
FCM_SERVER_KEY=
